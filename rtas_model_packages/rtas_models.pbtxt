# Auto-generated by tools/rtas_scan_packages.c. Do not edit by hand.
# Drop ST Edge AI output into rtas_model_packages/<model_id>/generated and rebuild.
# RTAS infers artifact paths and tensor metadata; semantic roles are controlled by naming rules.

schema_version: "0.2"
target: "STM32N6570-DK"
description: "Auto-scanned RTAS package registry for generated STM32N6 AI model artifacts."

runtime {
  control_mode: "auto_scan_codegen"
  zero_copy_camera_to_npu: true
  nn_input_buffer_count: 2
  telemetry_print_period_frames: 100
}

models {
  id: "blazeface_detector"
  role: "face_detection"
  generated_dir: "blazeface_detector/generated"
  api_prefix: "stai_network_face"
  wrapper_header: "stai_network.h"
  c_sources: "network_face.c"
  c_sources: "stai_network_face.c"
  aton_binary: "network_face_atonbuf.xSPI2.bin"
  flash_address: "0x71000000"
  origin_model_name: "blazeface_front_128_int8 (1)_OE_3_3_1"

  input {
    width: 128
    height: 128
    channels: 3
    dtype: "uint8"
    layout: "NHWC"
    color: "RGB"
    elements: 49152
    size_bytes: 49152
  }

  outputs {
    count: 4
    dtype: "float32"
    elements: 8192
    size_bytes: 32768
    width: 512
    height: 1
    channels: 16
  }

  cache_policy {
    before_sensor_dma_write: "invalidate_input_buffer"
    after_sensor_dma_write: "invalidate_input_buffer"
    before_npu_read: "clean_invalidate_input"
    after_npu_write: "invalidate_outputs"
  }

  scheduler {
    policy: "run_every_frame"
    priority: 1
  }
}

models {
  id: "mobilefacenet_embedder"
  role: "face_embedding"
  generated_dir: "mobilefacenet_embedder/generated"
  api_prefix: "stai_network_embed"
  c_sources: "network_embed.c"
  c_sources: "stai_network_embed.c"
  aton_binary: "network_embed_atonbuf.xSPI2.bin"
  flash_address: "0x71200000"
  origin_model_name: "mobilefacenet_int8_faces_OE_3_3_1"

  input {
    width: 112
    height: 112
    channels: 3
    dtype: "int8"
    layout: "CHW"
    color: "RGB"
    elements: 37632
    size_bytes: 37632
  }

  outputs {
    count: 1
    dtype: "float32"
    elements: 128
    size_bytes: 512
    width: 128
    height: 1
    channels: 1
  }

  cache_policy {
    before_npu_read: "clean_invalidate_input"
    after_npu_write: "invalidate_outputs"
  }

  scheduler {
    policy: "stable_single_face"
    priority: 2
    stable_face_frames: 2
    auth_recheck_ms: 250
    main_recheck_ms: 750
  }
}

models {
  id: "fastdepth_liveness"
  role: "depth_liveness"
  generated_dir: "fastdepth_liveness/generated"
  api_prefix: "stai_depth"
  c_sources: "depth.c"
  c_sources: "stai_depth.c"
  aton_binary: "depth_atonbuf.xSPI2.bin"
  flash_address: "0x71400000"
  origin_model_name: "fastdepth_224_int8_OE_3_3_1"

  input {
    width: 224
    height: 224
    channels: 3
    dtype: "uint8"
    layout: "NHWC"
    color: "RGB"
    elements: 150528
    size_bytes: 150528
  }

  outputs {
    count: 1
    dtype: "uint8"
    elements: 50176
    size_bytes: 50176
    width: 224
    height: 224
    channels: 1
  }

  cache_policy {
    before_npu_read: "clean_invalidate_input"
    after_npu_write: "invalidate_outputs"
  }

  scheduler {
    policy: "known_or_enrolling_stable_face"
    priority: 3
    stable_face_frames: 2
    depth_recheck_ms: 1000
  }
}
